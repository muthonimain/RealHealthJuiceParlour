# Copy to server/.env for local development

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
JWT_SECRET=change_this_to_a_long_random_secret

# PostgreSQL — required (use docker-compose for local)
DATABASE_URL=postgresql://rhjp:rhjp_local_dev@localhost:5432/rhjp_pos
# DigitalOcean managed DB often needs SSL:
# DATABASE_SSL=true

# Owners
OWNER_1_NAME=Carol
OWNER_1_USERNAME=Carol
OWNER_1_PASSWORD=your_password

OWNER_2_NAME=Martin
OWNER_2_USERNAME=Martin
OWNER_2_PASSWORD=your_password

# Employees
EMPLOYEE_1_NAME=Salma
EMPLOYEE_1_USERNAME=Salma
EMPLOYEE_1_PASSWORD=your_password

EMPLOYEE_2_NAME=Florence
EMPLOYEE_2_USERNAME=Florence
EMPLOYEE_2_PASSWORD=your_password
