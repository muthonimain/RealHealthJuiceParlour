# Copy to server/.env for local development

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
JWT_SECRET=change_this_to_a_long_random_secret

# Disk data directory (optional locally — defaults to server/persisted)
# On Render: mount a persistent disk at /var/data and set:
# DATA_DIR=/var/data

# Owners
OWNER_1_NAME=Carol
OWNER_1_USERNAME=Carol
OWNER_1_PASSWORD=your_password

OWNER_2_NAME=Martin
OWNER_2_USERNAME=Martin
OWNER_2_PASSWORD=your_password

# Employees
EMPLOYEE_1_NAME=Salma
EMPLOYEE_1_USERNAME=Salma
EMPLOYEE_1_PASSWORD=your_password

EMPLOYEE_2_NAME=Florence
EMPLOYEE_2_USERNAME=Florence
EMPLOYEE_2_PASSWORD=your_password
